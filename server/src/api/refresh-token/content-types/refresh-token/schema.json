{
    "kind": "collectionType",
    "collectionName": "refresh_tokens",
    "info": {
      "singularName": "refresh-token",
      "pluralName": "refresh-tokens",
      "displayName": "RefreshToken"
    },
    "options": {
      "draftAndPublish": false
    },
    "attributes": {
      "token": {
        "type": "string",
        "required": true,
        "unique": true
      },
      "user": {
        "type": "relation",
        "relation": "oneToOne",
        "target": "plugin::users-permissions.user"
      },
      "expiresAt": {
        "type": "datetime",
        "required": true
      }
    }
  }